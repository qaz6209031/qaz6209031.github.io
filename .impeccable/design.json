      "html": "<article class=\"ds-card\"><div class=\"ds-icon\">🗺️</div><a class=\"ds-title\" href=\"#\">Google Maps Route to GPX</a><div class=\"ds-sub\">Website</div><p class=\"ds-desc\">Converts Google Maps direction URLs into GPX files for cycling computers.</p><div class=\"ds-stat\">👥 100+ users per day</div></article>",
      "css": ":host{--bg:#0a0e17;--bg3:#1a2236;--accent:#6ee7b7;--accent2:#818cf8;--glow:rgba(110,231,183,0.25);--text:#e2e8f0;--text2:#94a3b8;--bright:#f8fafc;--border:rgba(148,163,184,0.12);}.ds-card{max-width:360px;background:rgba(26,34,54,0.5);backdrop-filter:blur(12px);border:1px solid var(--border);border-radius:20px;padding:32px;font-family:Sora,sans-serif;transition:all 0.4s cubic-bezier(0.22, 1, 0.36, 1);}.ds-icon{width:52px;height:52px;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:1.5rem;margin-bottom:18px;background:linear-gradient(135deg,rgba(110,231,183,0.15),rgba(129,140,248,0.15));border:1px solid rgba(110,231,183,0.2);}.ds-title{display:block;font-size:1.2rem;font-weight:700;color:var(--bright);text-decoration:none;margin-bottom:6px;transition:color 0.3s;}.ds-title:hover{color:var(--accent);}.ds-sub{font-family:'Space Mono',monospace;font-size:0.82rem;color:var(--accent2);margin-bottom:10px;}.ds-desc{font-size:0.92rem;line-height:1.6;color:var(--text2);margin:0 0 18px;}.ds-stat{font-size:0.8rem;font-weight:600;color:var(--accent);}"
