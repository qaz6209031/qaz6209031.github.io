      "css": ":host{--bg:#0a0e17;--bg3:#1a2236;--accent:#6ee7b7;--accent2:#818cf8;--glow:rgba(110,231,183,0.25);--text:#e2e8f0;--text2:#94a3b8;--bright:#f8fafc;--border:rgba(148,163,184,0.12);}.ds-badge{display:inline-flex;align-items:center;gap:8px;padding:6px 16px;border-radius:50px;background:rgba(110,231,183,0.08);border:1px solid rgba(110,231,183,0.2);font-family:Sora,sans-serif;font-size:0.85rem;font-weight:600;color:var(--accent);}.ds-dot{width:8px;height:8px;border-radius:50%;background:var(--accent);}"
